# @meta/input — клавиатура и мышь (порт 7882)
# cliclick для мыши + AppleScript System Events для клавиатуры.
# Требует Accessibility для bun или терминала, из которого запущен сервис.

@inputHost = http://localhost:7882

### Health (включает active probe Accessibility)
GET {{inputHost}}/health
Accept: application/json

> {%
  client.test("ok=true когда cliclick + accessibility", () => {
    client.assert(typeof response.body.cliclick === "string" || response.body.cliclick === null, "cliclick string|null")
    client.assert(typeof response.body.accessibility === "boolean", "accessibility is boolean")
  })
%}

### Bootstrap (повторная проверка + установка)
POST {{inputHost}}/bootstrap

### Проверить Accessibility разрешение
GET {{inputHost}}/permissions/accessibility
Accept: application/json

### Открыть System Settings → Privacy → Accessibility
POST {{inputHost}}/permissions/accessibility

// ════════════════════════════════════════════════════════════════════
// Проверка Accessibility — запускать ПОДРЯД сверху вниз после
// выдачи прав. Тесты должны стать зелёными.
// Что добавить в Accessibility:
//   - /opt/local/bin/cliclick (или путь из /health.cliclick)
//   - /Users/vladimirfilipenko/.bun/bin/bun
// ════════════════════════════════════════════════════════════════════

### 1. Bootstrap → проверить флаг accessibility
POST {{inputHost}}/bootstrap

> {%
  client.test("cliclick установлен", () => {
    client.assert(response.body.cliclick !== null,
      "cliclick не найден. Установите: brew install cliclick (или sudo port install cliclick)")
  })
  client.test("Accessibility выдан", () => {
    client.assert(response.body.accessibility === true,
      "Accessibility НЕ выдан! Добавьте в System Settings → Privacy → Accessibility:\n" +
      "  • " + (response.body.cliclick || "/opt/local/bin/cliclick") + "\n" +
      "  • /Users/vladimirfilipenko/.bun/bin/bun")
  })
%}

### 2. Запомнить текущую позицию курсора
GET {{inputHost}}/mouse/position

> {%
  client.global.set("probeStartX", response.body.x)
  client.global.set("probeStartY", response.body.y)
  client.log(`старт: (${response.body.x}, ${response.body.y})`)
  client.test("позиция получена", () => {
    client.assert(typeof response.body.x === "number" && typeof response.body.y === "number")
  })
%}

### 3. Двинуть курсор в (100, 100)
POST {{inputHost}}/mouse/move
Content-Type: application/json

{
  "x": 100,
  "y": 100
}

> {%
  client.test("via=cliclick", () => {
    client.assert(response.body.via === "cliclick", "ожидался via=cliclick, получили: " + response.body.via)
  })
%}

### 4. Проверить что курсор РЕАЛЬНО переместился
GET {{inputHost}}/mouse/position

> {%
  const x = response.body.x
  const y = response.body.y
  client.log(`после move: (${x}, ${y})`)
  client.test("курсор реально в (100, 100)", () => {
    const dx = Math.abs(x - 100)
    const dy = Math.abs(y - 100)
    client.assert(dx <= 2 && dy <= 2,
      `курсор НЕ переместился: ожидалось (100, 100), получено (${x}, ${y}). ` +
      "API вернул ok, но cliclick молча проигнорировался → нет Accessibility. " +
      "Откройте System Settings → Privacy → Accessibility и добавьте бинарники cliclick и bun.")
  })
%}

### 5. Вернуть курсор на исходное место
POST {{inputHost}}/mouse/move
Content-Type: application/json

{
  "x": {{probeStartX}},
  "y": {{probeStartY}}
}

### 6. Проверить клавиатуру (без побочных эффектов — нажмём Shift)
POST {{inputHost}}/keyboard/key
Content-Type: application/json

{
  "key": "shift"
}

> {%
  client.test("keyboard работает", () => {
    client.assert(response.body.ok === true,
      "keyboard вернул ошибку — проверьте Accessibility для bun (или терминала)")
  })
%}

### Текущая позиция курсора
GET {{inputHost}}/mouse/position
Accept: application/json

> {%
  client.test("есть x и y", () => {
    client.assert(typeof response.body.x === "number", "x is number")
    client.assert(typeof response.body.y === "number", "y is number")
  })
  client.global.set("mouseStartX", response.body.x)
  client.global.set("mouseStartY", response.body.y)
%}

### Переместить курсор в (500, 400)
POST {{inputHost}}/mouse/move
Content-Type: application/json

{
  "x": 500,
  "y": 400
}

### Вернуть курсор на исходную позицию
POST {{inputHost}}/mouse/move
Content-Type: application/json

{
  "x": {{mouseStartX}},
  "y": {{mouseStartY}}
}

### Левый клик в (500, 400)
POST {{inputHost}}/mouse/click
Content-Type: application/json

{
  "x": 500,
  "y": 400,
  "button": "left",
  "count": 1
}

### Двойной клик
POST {{inputHost}}/mouse/click
Content-Type: application/json

{
  "x": 500,
  "y": 400,
  "count": 2
}

### Тройной клик (выделить параграф)
POST {{inputHost}}/mouse/click
Content-Type: application/json

{
  "count": 3
}

### Правый клик (контекстное меню)
POST {{inputHost}}/mouse/click
Content-Type: application/json

{
  "x": 500,
  "y": 400,
  "button": "right"
}

### Drag from→to
POST {{inputHost}}/mouse/drag
Content-Type: application/json

{
  "from": { "x": 200, "y": 200 },
  "to":   { "x": 500, "y": 500 },
  "durationMs": 200
}

### Прокрутка вниз 3 строки
POST {{inputHost}}/mouse/scroll
Content-Type: application/json

{
  "dy": 3
}

### Прокрутка вверх 5 строк
POST {{inputHost}}/mouse/scroll
Content-Type: application/json

{
  "dy": -5
}

### Горизонтальная прокрутка
POST {{inputHost}}/mouse/scroll
Content-Type: application/json

{
  "dx": 3,
  "dy": 0
}

### Набрать текст
POST {{inputHost}}/keyboard/type
Content-Type: application/json

{
  "text": "Hello, World!"
}

### Набрать с задержкой между символами (для медленных приложений)
POST {{inputHost}}/keyboard/type
Content-Type: application/json

{
  "text": "Привет, мир!",
  "delayMs": 50
}

### Нажать Enter
POST {{inputHost}}/keyboard/key
Content-Type: application/json

{
  "key": "enter"
}

### Нажать Escape
POST {{inputHost}}/keyboard/key
Content-Type: application/json

{
  "key": "escape"
}

### Нажать стрелку вверх
POST {{inputHost}}/keyboard/key
Content-Type: application/json

{
