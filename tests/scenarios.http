# @meta/macos — end-to-end сценарии через несколько сервисов
# Запуск всех сервисов: bun run dev (в корне)

# ════════════════════════════════════════════════════════════════════
# Сценарий 1: Health-check всех сервисов разом
# ════════════════════════════════════════════════════════════════════

### 1.1 window
GET {{windowHost}}/health
Accept: application/json
> {% client.test("window ok", () => client.assert(response.body.ok === true)) %}

### 1.2 screen
GET {{screenHost}}/health
Accept: application/json
> {% client.test("screen ok", () => client.assert(response.body.ok === true)) %}

### 1.3 chrome
GET {{chromeHost}}/health
Accept: application/json
> {% client.test("chrome ok", () => client.assert(response.body.ok === true)) %}

### 1.4 android
GET {{androidHost}}/health
Accept: application/json

### 1.5 input
GET {{inputHost}}/health
Accept: application/json

# ════════════════════════════════════════════════════════════════════
# Сценарий 2: Открыть GitHub в новом окне Chrome → активировать → скриншот
# ════════════════════════════════════════════════════════════════════

### 2.1 Открыть новое окно Chrome
POST {{chromeHost}}/windows
Content-Type: application/json

{
  "url": "https://github.com"
}

> {%
  if (response.body.window) {
    client.global.set("scenario2WindowId", response.body.window.id)
  }
%}

### 2.2 Подождать загрузку (через reload с wait — он также ждёт первичную загрузку)
POST {{chromeHost}}/reload
Content-Type: application/json

{
  "windowId": {{scenario2WindowId}},
  "wait": true
}

### 2.3 Скриншот
POST {{chromeHost}}/screenshot
Content-Type: application/json

{
  "windowId": {{scenario2WindowId}},
  "detail": "medium",
  "caption": "Ожидаю главную страницу GitHub с поиском и логотипом"
}

### 2.4 Закрыть окно
DELETE {{chromeHost}}/windows/{{scenario2WindowId}}
Accept: application/json

# ════════════════════════════════════════════════════════════════════
# Сценарий 3: Открыть Spotlight через клавиатуру и найти приложение
# Требует: @meta/input с выданным Accessibility
# ════════════════════════════════════════════════════════════════════

### 3.1 Cmd+Space — открыть Spotlight
POST {{inputHost}}/keyboard/shortcut
Content-Type: application/json

{
  "shortcut": "cmd+space"
}

### 3.2 Набрать имя (с задержкой чтобы Spotlight успел обработать)
POST {{inputHost}}/keyboard/type
Content-Type: application/json

{
  "text": "Calculator",
  "delayMs": 30
}

### 3.3 Enter — запустить
POST {{inputHost}}/keyboard/key
Content-Type: application/json

{
  "key": "enter"
}

### 3.4 Скриншот рабочего стола чтобы проверить
POST {{screenHost}}/desktop
Content-Type: application/json

{
  "detail": "medium"
}

# ════════════════════════════════════════════════════════════════════
# Сценарий 4: Расположить два окна side-by-side
# ════════════════════════════════════════════════════════════════════

### 4.1 Chrome слева
POST {{windowHost}}/arrange
Content-Type: application/json

{
  "app": "Google Chrome",
  "preset": "left"
}

### 4.2 iTerm справа
POST {{windowHost}}/arrange
Content-Type: application/json

{
  "app": "iTerm2",
  "preset": "right"
}

### 4.3 Скриншот рабочего стола
POST {{screenHost}}/desktop
Content-Type: application/json

{
  "detail": "medium"
}

# ════════════════════════════════════════════════════════════════════
# Сценарий 5: Прочитать ошибки из console текущей вкладки Chrome
# Требует: @meta/chrome в CDP режиме (bun run cdp в директории chrome)
# ════════════════════════════════════════════════════════════════════

### 5.1 Получить активную вкладку
GET {{chromeHost}}/tabs/active
Accept: application/json

> {%
  if (response.body) {
    client.global.set("activeTabWindowId", response.body.windowId)
    client.global.set("activeTabIndex", response.body.index)
  }
%}

### 5.2 Reload (чтобы получить свежие console-сообщения с момента загрузки)
POST {{chromeHost}}/reload
Content-Type: application/json

{
  "windowId": {{activeTabWindowId}},
  "tabIndex": {{activeTabIndex}}
}

### 5.3 Слушать console 2 секунды
POST {{chromeHost}}/console
Content-Type: application/json

{
  "windowId": {{activeTabWindowId}},
  "tabIndex": {{activeTabIndex}},
  "durationMs": 2000
}

> {%
  if (response.status === 200) {
    const errors = response.body.entries.filter(e => e.level === "error")
    const warns = response.body.entries.filter(e => e.level === "warn")
    client.log(`errors: ${errors.length}, warns: ${warns.length}, total: ${response.body.count}`)
  }
%}
