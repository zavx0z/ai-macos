{
  "name": "macos",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "workspaces": ["shared", "window", "screen", "chrome", "android", "input", "mcp"],
  "scripts": {
    "dev": "bun run --filter '@meta/window' --filter '@meta/screen' --filter '@meta/chrome' --filter '@meta/android' --filter '@meta/input' dev",
    "mcp": "bun run --cwd mcp start",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test input/tests mcp/tests",
    "build": "bun run --filter '@meta/window' --filter '@meta/screen' --filter '@meta/chrome' --filter '@meta/android' --filter '@meta/input' --filter '@meta/mcp' build"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
