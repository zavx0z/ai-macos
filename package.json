{
  "name": "macos",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "workspaces": ["shared", "window", "screen", "chrome", "android", "input", "mcp", "runtime", "native"],
  "scripts": {
    "doctor:source": "bun scripts/source-doctor.ts",
    "dev": "bun run --filter '@meta/window' --filter '@meta/screen' --filter '@meta/chrome' --filter '@meta/input' dev",
    "dev:android": "ANDROID_AUTO_INSTALL=false bun run --cwd android dev",
    "mcp": "bun run --cwd mcp start"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
