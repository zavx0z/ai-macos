-+export async function writePng(path: string, data: Uint8Array): Promise<void> {
-+  const parent = path.slice(0, path.lastIndexOf("/"));
-+  if (parent.length > 0) await mkdir(parent, { recursive: true });
-+  await Bun.write(path, data);
-+}
