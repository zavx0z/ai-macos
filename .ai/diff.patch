-+function parseArgs(argv: string[]): { cmd: string; args: Args; positional: string[] } {
-+  const [cmd = "", ...rest] = argv;
-+  const args: Args = {};
-+  const positional: string[] = [];
-+  for (let i = 0; i < rest.length; i++) {
-+    const a = rest[i]!;
