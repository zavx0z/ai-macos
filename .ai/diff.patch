-+async function run(command: string[]): Promise<void> {
-+  const proc = spawn(command, { stdout: "pipe", stderr: "pipe" });
-+  const [out, err, code] = await Promise.all([
-+    new Response(proc.stdout).text(),
-+    new Response(proc.stderr).text(),
-+    proc.exited,
-+  ]);
-+  if (code !== 0) {
