-  const propsExpr = props.length ? ` with properties {${props.join(", ")}}` : "";
-  const script = `
-    tell application "Google Chrome"
-      activate
-      set w to make new window${propsExpr}
-      ${options.url ? `set URL of active tab of w to ${quote(options.url)}` : ""}
-      return id of w
